# Copy this file to .env only if you want to run live eBay API collection.
# Do not commit .env. The included database supports offline inspection without credentials.

EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_MARKETPLACES=EBAY_DE,EBAY_US
WATCHPARTS_DB=database/watchparts.duckdb
